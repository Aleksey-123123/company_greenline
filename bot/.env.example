# Скопировать в .env и заполнить. Файл .env в git не попадает.

# Токен бота от @BotFather
BOT_TOKEN=123456:ABC...

# Хранилище: sheets — Google Таблица; memory — в памяти (для пробы без Google, всё теряется при перезапуске)
STORAGE=sheets

# ID Google Таблицы — часть адреса между /d/ и /edit
SHEET_ID=1AbC...

# Путь к JSON-ключу сервисного аккаунта Google (таблицу надо расшарить на его e-mail с правом редактора)
GOOGLE_CREDENTIALS=/app/secrets/service-account.json

# Чат-архив для фото и файлов: группа или канал, где бот — администратор. Формат -100…
# Пусто — фото не копируются, в таблицу пишется только file_id.
ARCHIVE_CHAT_ID=

# Telegram ID администраторов бота через запятую: им приходят новые пользователи и сообщения об ошибках
ADMIN_IDS=

# Часовой пояс для дат в таблице
TZ=Asia/Novosibirsk
