# Скопировать в .env и заполнить. Файл .env в git не попадает.

# Токен бота от @BotFather
BOT_TOKEN=123456:ABC...

# Хранилище: sheets — Google Таблица; memory — в памяти (для пробы без Google, всё теряется при перезапуске)
STORAGE=sheets

# Google Таблица: можно вставить адрес из браузера целиком
SHEET_ID=https://docs.google.com/spreadsheets/d/1AbC.../edit

# Путь к JSON-ключу сервисного аккаунта Google, относительно папки bot/
# (таблицу надо расшарить на e-mail сервисного аккаунта с правом редактора)
GOOGLE_CREDENTIALS=secrets/service-account.json

# Архив фото и файлов: закрытый КАНАЛ, где бот — администратор. Формат -100…
# Узнать: написать в канале /chatid — бот ответит.
# Пусто — фото не копируются, в таблицу пишется только file_id.
ARCHIVE_CHAT_ID=

# Необязательно. Telegram ID через запятую, кому ещё слать новых пользователей и ошибки в боте
# (активные директор и помощник получают их и без списка). Сбои архива фото — только этим ID.
ADMIN_IDS=

# Часовой пояс для дат в таблице
TZ=Asia/Novosibirsk
